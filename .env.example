# Copia este archivo a .env y completa tus valores reales.
# .env está en .gitignore: nunca lo compartas ni lo subas a git/zips.
# NUNCA pongas llaves reales en ESTE archivo (.env.example): es una
# plantilla que SÍ se sube al repositorio.

SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-publica"
SECRET_KEY="genera-una-cadena-aleatoria-larga"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"

